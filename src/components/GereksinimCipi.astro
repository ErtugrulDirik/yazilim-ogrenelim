---
// Tek bir gereksinimin rozeti: kurulum sayfasına götürür. Sayfası henüz yoksa sadece adı görünür.
import { GEREKSINIMLER } from '../gereksinimler.mjs';

interface Props {
	id: string;
}

const { id } = Astro.props;
const g = GEREKSINIMLER[id as keyof typeof GEREKSINIMLER];
if (!g) throw new Error(`Bilinmeyen gereksinim: "${id}" (src/gereksinimler.mjs içinde tanımlı değil)`);
const kok = import.meta.env.BASE_URL.replace(/\/?$/, '');
const url = g.sayfa ? kok + g.sayfa : null;
const baslik = g.ozet + (g.windows === 'wsl' ? ' · Windows’ta WSL gerekir' : '');
---

{
	url ? (
		<a class:list={['cip', { 'cip-wsl': g.windows === 'wsl' }]} href={url} title={baslik}>
			{g.ad}
		</a>
	) : (
		<span class="cip cip-yakinda" title={`${g.ozet} · kurulum sayfası yakında`}>
			{g.ad}
		</span>
	)
}

<style>
	.cip {
		display: inline-block;
		padding: 0.05rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		line-height: 1.6;
		text-decoration: none;
		color: var(--sl-color-accent-high);
		background: var(--sl-color-accent-low);
		border: 1px solid var(--sl-color-accent);
	}
	a.cip:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-accent-high);
	}
	.cip-wsl {
		color: var(--sl-color-orange-high);
		background: var(--sl-color-orange-low);
		border-color: var(--sl-color-orange);
	}
	.cip-yakinda {
		color: var(--sl-color-gray-3);
		background: transparent;
		border-style: dashed;
		border-color: var(--sl-color-gray-4);
	}
</style>
